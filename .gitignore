# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.zip

# Virtual environments
.venv
env/

# Fichiers générés (cartes HTML, CSV, logos)
output/

# Cache local des GTFS récupérés depuis le catalogue Hugging Face
# (dataset antoinechevre/accessibility-data, dossier GTFS/) — repeuplé au
# besoin par src/hf_cache.recuperer_depuis_hf, cf. app.py
data/GTFS/

# Cache local des tronçons uniques et indicateurs par tronçon, par réseau
# — repeuplé au besoin par src/utils.charger_ou_calculer_gdf, cf.
# views/troncons.py et gtfs_notebook_idf.ipynb
data/memory_troncons/

# Cache local de l'index de benchmark inter-réseaux partagé — repeuplé au
# besoin par src/hf_cache.lire_csv_partage, cf. views/benchmark.py
data/benchmark/

# Cache local des matrices de temps de trajet (dataset
# antoinechevre/accessibility-data, dossier memory_ttm/) — repeuplé au
# besoin par src/hf_cache.recuperer_depuis_hf
data/memory_ttm/

# Cache local des rasters WorldPop bruts téléchargés par pays (un GeoTIFF
# par pays/année, plusieurs centaines de Mo pièce) — cf. world_pop_data.ipynb
data/worldpop/

# Cache local du catalogue GTFS Afrique (app_africa.py) — même principe que
# data/GTFS/ ci-dessus : repeuplé au besoin depuis le dataset HF partagé
# (préfixe GTFS_Africa/, cf. src/hf_cache.py), jamais commité.
data/GTFS_Africa/

# GTFS retirés du catalogue sélectionnable (collision de nom de ville ou
# données corrompues, ex. Abidjan_AMUGA_GTFS_2025_mapping_v2.zip vs.
# Abidjan_gtfs.zip) : gardés hors de data/GTFS_Africa/ pour ne plus jamais
# être proposés dans l'app, jamais commités non plus.
data/GTFS_Africa_deprecated/

# Dossier de travail scratch pour l'extraction OSM (tuiles .osm téléchargées
# puis découpées à l'osmium, cf. src/osm_extract.py) — fichiers intermédiaires
# jetables, jamais le PBF final (mis en cache sur HF, memory_pbf/).
data/osm_extract/

# Cache local des extraits pays Geofabrik (plusieurs dizaines à centaines
# de Mo pièce) et de l'index de son catalogue — cf.
# src/osm_extract.osm_pbf_creator_depuis_geofabrik.
data/osm_pbf_pays/

# Cache local des .osm.pbf finaux par réseau (découpés sur la zone GTFS+marge,
# prêts pour r5py) — repeuplé au besoin depuis le dataset HF partagé
# (memory_pbf/, cf. index_accessibility_notebook_africa.ipynb).
data/memory_pbf/

# Cache local des équipements OSM pondérés par réseau (substitut BPE pour
# l'Afrique) — repeuplé au besoin depuis le dataset HF partagé
# (equipements_osm/, cf. index_accessibility_notebook_africa.ipynb).
data/equipements_osm/

# Cache local des grilles de population déjà construites, par réseau —
# repeuplé au besoin depuis le dataset HF partagé (memory_gpkg/, cf.
# src.worldpop.charger_ou_construire_grille_population_reseau).
data/memory_gpkg/

# Logs de run locaux (ex: scripts/run_notebook_afrique.py en arrière-plan)
*.log

# macOS
.DS_Store

# Secrets locaux (jamais commités)
HF_token
.env
*.env
.venv312/
