# Virtual environments
.venv
env/

# Fichiers générés (cartes HTML, CSV, logos)
output/

# Cache local des GTFS récupérés depuis le catalogue Hugging Face
# (dataset antoinechevre/accessibility-data, dossier GTFS/) — repeuplé au
# besoin par src/hf_cache.recuperer_depuis_hf, cf. app.py
data/GTFS/

# Cache local des tronçons uniques et indicateurs par tronçon, par réseau
# — repeuplé au besoin par src/utils.charger_ou_calculer_gdf, cf.
# views/troncons.py et gtfs_notebook_idf.ipynb
data/memory_troncons/

# Cache local de l'index de benchmark inter-réseaux partagé — repeuplé au
# besoin par src/hf_cache.lire_csv_partage, cf. views/benchmark.py
data/benchmark/

# Cache local des matrices de temps de trajet (dataset
# antoinechevre/accessibility-data, dossier memory_ttm/) — repeuplé au
# besoin par src/hf_cache.recuperer_depuis_hf
data/memory_ttm/

# Cache local des rasters WorldPop bruts téléchargés par pays (un GeoTIFF
# par pays/année, plusieurs centaines de Mo pièce) — cf. world_pop_data.ipynb
data/worldpop/

# Cache local du catalogue GTFS Afrique (app_africa.py) — même principe que
# data/GTFS/ ci-dessus : repeuplé au besoin depuis le dataset HF partagé
# (préfixe GTFS_Africa/, cf. src/hf_cache.py), jamais commité.
data/GTFS_Africa/

# Dossier de travail scratch pour l'extraction OSM (tuiles .osm téléchargées
# puis découpées à l'osmium, cf. src/osm_extract.py) — fichiers intermédiaires
# jetables, jamais le PBF final (mis en cache sur HF, memory_pbf/).
data/osm_extract/

# macOS
.DS_Store

# Secrets locaux (jamais commités)
HF_token
